<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local dev backend. Tighten or remove for any non-debug build.
         10.0.2.2 = Android emulator's host alias.
         192.168.29.234 = dev machine's LAN IP for real-device testing. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.29.234</domain>
    </domain-config>
</network-security-config>
